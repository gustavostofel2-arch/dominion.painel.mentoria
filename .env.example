# Copie este arquivo para .env.local e preencha com os valores do SEU projeto no Supabase
# (Supabase > Project Settings > API Keys). Nunca coloque estes valores no GitHub.

# Endereço do projeto, algo como https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "publishable" (pública, pode ficar no navegador). Começa com sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
